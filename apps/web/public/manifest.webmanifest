{
  "id": "vaenyx-app",
  "name": "Vaenyx",
  "short_name": "Vaenyx",
  "description": "Self-hosted, local-first personal agent framework.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#262624",
  "theme_color": "#262624",
  "icons": [
    {
      "src": "/vaenyx-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/vaenyx-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/vaenyx-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/vaenyx-icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            "text/plain",
            ".txt",
            "text/markdown",
            ".md",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            ".pptx"
          ]
        }
      ]
    }
  }
}
