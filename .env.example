# Local server
NODE_ENV=development
VAENYX_HOST=127.0.0.1
VAENYX_PORT=3000
VAENYX_LOG_LEVEL=info

# Paths are resolved from apps/server when using npm workspace commands.
VAENYX_DATA_DIR=../../private/data
VAENYX_MIGRATIONS_DIR=./migrations
VAENYX_WEB_DIST=../web/dist

# Comma-separated browser origins allowed during local development.
VAENYX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
