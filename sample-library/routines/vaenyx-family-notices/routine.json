{
  "name": "Family Notices",
  "description": "Turn a notice into dates, places and a preparation checklist.",
  "owner": "vaenyx",
  "version": "1.0.0",
  "tags": [
    "first-party",
    "household",
    "modular"
  ],
  "mode": "accumulate",
  "storage": {
    "journal": true,
    "gallery": true
  },
  "deps": [
    {
      "methodId": "vaenyx-family-notices",
      "version": "1.0.0"
    }
  ],
  "flow": [
    {
      "id": "organise",
      "methodId": "vaenyx-family-notices",
      "from": "journal"
    }
  ],
  "view": {
    "version": 1,
    "layout": "family-notices-v1",
    "fields": [
      {
        "key": "title",
        "as": "title"
      },
      {
        "key": "summary",
        "as": "text"
      },
      {
        "key": "fields",
        "as": "table",
        "label": "Details",
        "labelZh": "资料",
        "columns": [
          {
            "key": "label",
            "label": "Field",
            "labelZh": "项目"
          },
          {
            "key": "value",
            "label": "Value",
            "labelZh": "内容"
          },
          {
            "key": "quote",
            "label": "Source Quote",
            "labelZh": "来源原文"
          }
        ]
      },
      {
        "key": "checklist",
        "as": "bullets",
        "label": "Checklist",
        "labelZh": "清单"
      },
      {
        "key": "checks",
        "as": "bullets",
        "label": "Check",
        "labelZh": "待核对"
      }
    ]
  }
}
